# Copy to .env (or set these in your host's dashboard). Only PUBLIC_URL and the
# first-admin pair are needed to go live; everything else is optional.

# Where the site lives. Used for ticket links in SMS and the share image.
PUBLIC_URL=https://your-domain.example

# Port to listen on (most hosts set this for you).
PORT=3000

# Folder for the database file (socialspot.db). Must be on persistent storage.
DATA_DIR=./data

# First admin login, created on the first start if no staff exist yet.
# Remove ADMIN_PASSWORD from the host once you have signed in and changed it.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-password
ADMIN_NAME=Zah

# Signs staff sessions. If unset, one is generated and kept in DATA_DIR.
SESSION_SECRET=

# SMS through Africa's Talking (optional). Without these, messages wait in
# Admin -> Messages and staff send them on WhatsApp with one tap.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# AT_SANDBOX=1

# Behind a proxy (Render, Railway, nginx) client IPs come from X-Forwarded-For.
# Set TRUST_PROXY=0 if the server is exposed directly.
TRUST_PROXY=1
